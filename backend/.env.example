NODE_ENV=development

DB_NAME=library
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public

BACKEND_PORT=3001

SEED_PASSWORD=your-password-here
ALLOW_DESTRUCTIVE_SEED=false

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000

# No email/SMS provider yet: reset codes are shown in the app instead of being sent
SIMULATE_MESSAGE_DELIVERY=true
